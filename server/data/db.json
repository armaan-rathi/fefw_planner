      "fields": {
        "faction": "Ribeira Winds",
        "backstory": "Grew up alongside Cai like brothers. A 15-year-old with extraordinary eyesight — said to see the stars even in daytime. Kind and timid by nature, which reportedly holds back otherwise outstanding archery. Joins on Cai's route.\n\nReported by Serenes Forest (verify from in-game screens): class Archer; proficiencies Bow / Infantry; personal skill \"Sharpshooting\" (extends range when using combat arts). Likes: mother's cooking, Ginji fruit, cloud-watching."
      }
    },
    {
      "id": "unit_tobias",
      "name": "Tobias",
      "portrait": null,
      "isLord": false,
      "routeIds": [
        "theodora"
      ],
      "starterFor": [],
      "classId": "class_armored",
      "boons": [],
      "banes": [],
      "skillLevels": {},
