# Copy to .env (or set in your host's dashboard) for production.

# The editor password. When set, adding/editing data and uploading images
# require signing in with this password. Reads (everything fans see) stay public.
# If UNSET, the server runs "open" — fine for local dev, NOT for public hosting.
ADMIN_PASSWORD=change-me-to-a-long-random-string

# Optional. Hosts usually inject PORT automatically; only set this to override.
# PORT=8080
